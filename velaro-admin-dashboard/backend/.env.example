PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# ==========================================
# Email Notification Configuration (Nodemailer)
# ==========================================
# For Gmail (Recommended):
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your email and the 16-character App Password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Optional: Custom From address (e.g., "Velaro Atelier" <your_email@gmail.com>)
# EMAIL_FROM=your_email@gmail.com

# Alternatively, for Custom SMTP (Outlook, SendGrid, Mailgun, AWS SES, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_smtp_password
